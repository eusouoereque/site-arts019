# ============================================================
#  Pack Designer 019 — arts019.com
#  Performance + HTTPS. Colocar na MESMA pasta do index.html.
# ============================================================

# ---------- 1. Forçar HTTPS (http -> https) ----------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------- 2. Compressão (arquivos de texto) ----------
# Não comprime imagem/vídeo/fonte (já são comprimidos).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- 3. Cache do navegador ----------
<IfModule mod_expires.c>
    ExpiresActive On

    # Imagens e vídeos (nomes estáveis) — 1 ano
    ExpiresByType image/webp     "access plus 1 year"
    ExpiresByType image/png      "access plus 1 year"
    ExpiresByType image/jpeg     "access plus 1 year"
    ExpiresByType image/svg+xml  "access plus 1 year"
    ExpiresByType video/mp4      "access plus 1 year"
    ExpiresByType font/woff2     "access plus 1 year"

    # CSS e JS — 7 dias (equilíbrio: rápido, mas atualizações aparecem logo)
    ExpiresByType text/css            "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"

    # HTML — sempre revalida (para trocas de conteúdo aparecerem na hora)
    ExpiresByType text/html      "access plus 0 seconds"
</IfModule>

# ---------- 4. Reforço do cache + segurança ----------
<IfModule mod_headers.c>
    <FilesMatch "\.(webp|png|jpe?g|svg|mp4|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    # Evita que o navegador "adivinhe" tipos de arquivo (segurança)
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# ---------- 5. Página inicial padrão ----------
DirectoryIndex index.html
